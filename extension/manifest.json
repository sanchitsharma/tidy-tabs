{
  "manifest_version": 3,
  "name": "Tidy Tabs AI",
  "version": "0.3.0",
  "key": "",
  "description": "Groups your tabs by the task you're on into named tab groups with AI: Claude via Claude Code, Ollama, or Chrome's built-in model.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tidy Tabs AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "tidy-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "Tidy the tabs in the current window"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "storage",
    "tabGroups",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost:11434/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "version_name": "0.3.0",
  "incognito": "not_allowed"
}
